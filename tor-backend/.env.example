NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<database_user>:<database_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tor_software

# Authentication
# Secret used to sign access tokens (HMAC-SHA256). REQUIRED in production, min 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
